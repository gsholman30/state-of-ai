<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The State of AI: Garrett Holman</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,700;0,9..144,900;1,9..144,400&family=Instrument+Sans:wght@300;400;500&family=Martian+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0a0907;
  --paper: #f2ede6;
  --red: #c93515;
  --blue: #153a8e;
  --green: #0d4a2a;
  --gold: #c8993a;
  --muted: #7a7065;
  --card: #1a1612;
  --rule: rgba(255,255,255,0.1);
}

* { margin:0; padding:0; box-sizing:border-box; }

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--paper);
  font-family: 'Instrument Sans', sans-serif;
  font-weight: 300;
  font-size: 18px;
  line-height: 1.85;
  overflow-x: hidden;
}

/* SCROLL REVEAL */
.reveal {
  opacity: 0;
  transform: translateY(32px);
  transition: opacity 0.75s ease, transform 0.75s ease;
}
.reveal.visible {
  opacity: 1;
  transform: none;
}
.reveal-delay-1 { transition-delay: 0.1s; }
.reveal-delay-2 { transition-delay: 0.2s; }
.reveal-delay-3 { transition-delay: 0.3s; }
.reveal-delay-4 { transition-delay: 0.4s; }

/* ══ HERO ══ */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  position: relative;
  overflow: hidden;
  padding: 0;
}
.hero-img {
  position: absolute;
  inset: 0;
  background-image: url('https://images.unsplash.com/photo-1677756119517-756a188d2d94?w=1600&auto=format&fit=crop&q=80');
  background-size: cover;
  background-position: center 30%;
  filter: brightness(0.35) saturate(0.7);
}
.hero-img::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, var(--bg) 25%, transparent 70%);
}
.hero-content {
  position: relative;
  z-index: 2;
  padding: 5rem 7vw 5rem;
}
.hero-eyebrow {
  font-family: 'Martian Mono', monospace;
  font-size: 0.65rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 2rem;
  display: block;
  opacity: 0;
  animation: fadeUp 0.8s 0.3s forwards;
}
.hero h1 {
  font-family: 'Fraunces', serif;
  font-size: clamp(3rem, 8vw, 7.5rem);
  font-weight: 900;
  line-height: 0.95;
  margin-bottom: 2.5rem;
  max-width: 900px;
  opacity: 0;
  animation: fadeUp 0.9s 0.5s forwards;
}
.hero h1 em {
  font-style: italic;
  color: var(--gold);
}
.hero-sub {
  font-family: 'Instrument Sans', sans-serif;
  font-size: 1.1rem;
  color: rgba(242,237,230,0.6);
  max-width: 560px;
  line-height: 1.7;
  margin-bottom: 2.5rem;
  opacity: 0;
  animation: fadeUp 0.9s 0.7s forwards;
}
.hero-meta {
  font-family: 'Martian Mono', monospace;
  font-size: 0.62rem;
  color: rgba(242,237,230,0.3);
  letter-spacing: 0.15em;
  border-top: 1px solid var(--rule);
  padding-top: 1.5rem;
  opacity: 0;
  animation: fadeUp 0.8s 0.9s forwards;
}
.scroll-cue {
  position: absolute;
  bottom: 2.5rem;
  right: 5vw;
  font-family: 'Martian Mono', monospace;
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  color: rgba(242,237,230,0.25);
  writing-mode: vertical-rl;
  text-transform: uppercase;
  animation: fadeIn 1.5s 1.2s forwards;
  opacity: 0;
}

@keyframes fadeUp {
  to { opacity: 1; transform: none; }
  from { opacity: 0; transform: translateY(20px); }
}
@keyframes fadeIn {
  to { opacity: 1; }
}

/* ══ NAV BAR ══ */
.nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(10,9,7,0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--rule);
  display: flex;
  align-items: center;
  gap: 0;
  padding: 0 5vw;
  overflow-x: auto;
}
.nav a {
  font-family: 'Martian Mono', monospace;
  font-size: 0.6rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(242,237,230,0.4);
  text-decoration: none;
  padding: 1rem 1.2rem;
  white-space: nowrap;
  transition: color 0.2s;
  border-bottom: 2px solid transparent;
}
.nav a:hover { color: var(--gold); border-bottom-color: var(--gold); }

/* ══ LAYOUT ══ */
.prose {
  max-width: 760px;
  margin: 0 auto;
  padding: 5rem 5vw;
}
section { position: relative; }

/* ══ LABELS ══ */
.eyebrow {
  font-family: 'Martian Mono', monospace;
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold);
  display: block;
  margin-bottom: 1.2rem;
}
.accent-bar {
  width: 44px;
  height: 3px;
  background: var(--gold);
  margin-bottom: 2rem;
}

/* ══ HEADINGS ══ */
h2 {
  font-family: 'Fraunces', serif;
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 700;
  line-height: 1.1;
  margin-bottom: 1.8rem;
}
h3 {
  font-family: 'Fraunces', serif;
  font-size: 1.4rem;
  font-weight: 400;
  font-style: italic;
  margin: 2.5rem 0 1rem;
  color: var(--gold);
}

p { margin-bottom: 1.5rem; color: rgba(242,237,230,0.88); }

hr.rule { border: none; border-top: 1px solid var(--rule); }

/* ══ FULL-WIDTH IMAGE BREAKS ══ */
.img-break {
  width: 100%;
  height: 55vh;
  min-height: 320px;
  position: relative;
  overflow: hidden;
}
.img-break img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: brightness(0.55) saturate(0.8);
  transform: scale(1.05);
  transition: transform 8s ease;
}
.img-break:hover img { transform: scale(1.0); }
.img-break-caption {
  position: absolute;
  bottom: 1.5rem;
  left: 2rem;
  font-family: 'Martian Mono', monospace;
  font-size: 0.58rem;
  letter-spacing: 0.15em;
  color: rgba(242,237,230,0.45);
  text-transform: uppercase;
}

/* ══ ARGUMENT BANNERS ══ */
.arg-banner {
  padding: 5rem 7vw;
  position: relative;
  overflow: hidden;
}
.arg-banner::before {
  content: attr(data-num);
  position: absolute;
  right: -0.05em;
  top: -0.15em;
  font-family: 'Fraunces', serif;
  font-size: 22vw;
  font-weight: 900;
  color: rgba(255,255,255,0.04);
  line-height: 1;
  pointer-events: none;
}
.arg-banner.red  { background: var(--red); }
.arg-banner.blue { background: var(--blue); }
.arg-banner.green{ background: var(--green); }
.arg-banner h2 {
  font-size: clamp(2rem, 4.5vw, 3.8rem);
  max-width: 680px;
  color: white;
}
.arg-banner .arg-label {
  font-family: 'Martian Mono', monospace;
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.5);
  margin-bottom: 1.2rem;
  display: block;
}

/* ══ PULL QUOTE ══ */
.pullquote {
  border-left: 3px solid var(--gold);
  padding: 1.5rem 2rem;
  margin: 3rem 0;
  background: rgba(200,153,58,0.06);
}
.pullquote p {
  font-family: 'Fraunces', serif;
  font-size: 1.35rem;
  font-style: italic;
  color: var(--paper);
  margin: 0 0 0.8rem;
  line-height: 1.5;
}
.pullquote cite {
  font-family: 'Martian Mono', monospace;
  font-size: 0.6rem;
  color: rgba(242,237,230,0.4);
  letter-spacing: 0.1em;
  font-style: normal;
}

/* ══ SLIDE CARDS ══ */
.slide-card {
  background: var(--card);
  border-top: 2px solid var(--gold);
  padding: 1.8rem 2rem 1.5rem;
  margin: 2.5rem 0;
}
.slide-card .sc-label {
  font-family: 'Martian Mono', monospace;
  font-size: 0.58rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 0.5rem;
  display: block;
}
.slide-card .sc-title {
  font-family: 'Fraunces', serif;
  font-size: 1.05rem;
  color: var(--paper);
  margin-bottom: 0.6rem;
}
.slide-card .sc-body {
  font-size: 0.9rem;
  color: rgba(242,237,230,0.6);
  line-height: 1.7;
  margin: 0;
}
.slide-card .sc-attr {
  font-family: 'Martian Mono', monospace;
  font-size: 0.58rem;
  color: var(--gold);
  margin-top: 0.8rem;
  display: block;
  opacity: 0.8;
}

/* ══ STAT GRID ══ */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 1px;
  background: var(--rule);
  margin: 3rem 0;
}
.stat-cell {
  background: var(--card);
  padding: 2.5rem 1.5rem;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.stat-cell::before {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 2px;
  background: var(--gold);
  transform: scaleX(0);
  transition: transform 0.5s ease;
}
.stat-cell:hover::before { transform: scaleX(1); }
.stat-n {
  font-family: 'Fraunces', serif;
  font-size: 3.5rem;
  color: var(--gold);
  line-height: 1;
  display: block;
  margin-bottom: 0.6rem;
}
.stat-d {
  font-size: 0.8rem;
  color: rgba(242,237,230,0.5);
  line-height: 1.5;
}

/* ══ PERSONAL BLOCK ══ */
.personal-block {
  border: 1px solid rgba(200,153,58,0.25);
  padding: 2.2rem 2.5rem;
  margin: 2.5rem 0;
  position: relative;
}
.personal-block::before {
  content: 'Personal Account';
  font-family: 'Martian Mono', monospace;
  font-size: 0.58rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  background: var(--gold);
  color: var(--bg);
  padding: 0.25rem 0.7rem;
  position: absolute;
  top: -0.85rem;
  left: 1.5rem;
}
.personal-block p {
  font-style: italic;
  color: rgba(242,237,230,0.65);
}

/* ══ CITATION LINKS ══ */
a.cite-link {
  color: var(--gold);
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  font-family: 'Martian Mono', monospace;
  font-size: 0.75rem;
}
a.cite-link:hover { opacity: 0.7; }

/* ══ VIDEO SECTION ══ */
.video-section {
  background: var(--card);
  padding: 4rem 7vw;
}
.video-section .video-label {
  font-family: 'Martian Mono', monospace;
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 1rem;
  display: block;
}
.video-section h3 {
  font-family: 'Fraunces', serif;
  font-size: 1.5rem;
  font-style: normal;
  font-weight: 700;
  color: var(--paper);
  margin: 0 0 0.6rem;
}
.video-section p {
  font-size: 0.92rem;
  color: rgba(242,237,230,0.55);
  margin-bottom: 2rem;
  max-width: 600px;
}
.video-wrap {
  position: relative;
  padding-bottom: 56.25%;
  height: 0;
  overflow: hidden;
  max-width: 800px;
}
.video-wrap iframe {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  border: none;
}

/* ══ INTERACTIVE POLL ══ */
.poll-section {
  background: linear-gradient(135deg, #0f1a3a 0%, #0a0907 100%);
  padding: 5rem 7vw;
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
}
.poll-section h3 {
  font-family: 'Fraunces', serif;
  font-size: 1.8rem;
  font-style: normal;
  font-weight: 700;
  color: var(--paper);
  margin-bottom: 0.5rem;
}
.poll-section .poll-sub {
  font-size: 0.9rem;
  color: rgba(242,237,230,0.5);
  margin-bottom: 2.5rem;
}
.poll-question {
  font-family: 'Fraunces', serif;
  font-size: 1.25rem;
  font-style: italic;
  color: var(--paper);
  margin-bottom: 1.5rem;
  max-width: 620px;
}
.poll-options {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  max-width: 580px;
}
.poll-btn {
  background: transparent;
  border: 1px solid rgba(200,153,58,0.3);
  color: rgba(242,237,230,0.75);
  padding: 1rem 1.5rem;
  font-family: 'Instrument Sans', sans-serif;
  font-size: 0.95rem;
  cursor: pointer;
  text-align: left;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}
.poll-btn:hover {
  border-color: var(--gold);
  color: var(--paper);
  background: rgba(200,153,58,0.08);
}
.poll-btn.selected {
  border-color: var(--gold);
  background: rgba(200,153,58,0.15);
  color: var(--paper);
}
.poll-bar {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  background: rgba(200,153,58,0.12);
  transition: width 0.6s ease;
  z-index: 0;
}
.poll-btn-text {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
}
.poll-pct {
  font-family: 'Martian Mono', monospace;
  font-size: 0.7rem;
  color: var(--gold);
  opacity: 0;
  transition: opacity 0.3s 0.4s;
}
.poll-pct.show { opacity: 1; }
.poll-result {
  margin-top: 1.5rem;
  font-family: 'Fraunces', serif;
  font-size: 1.1rem;
  font-style: italic;
  color: var(--gold);
  opacity: 0;
  transition: opacity 0.4s;
  min-height: 1.5rem;
}
.poll-result.show { opacity: 1; }
.poll-reset {
  margin-top: 1rem;
  background: none;
  border: none;
  font-family: 'Martian Mono', monospace;
  font-size: 0.62rem;
  letter-spacing: 0.12em;
  color: rgba(242,237,230,0.3);
  cursor: pointer;
  text-transform: uppercase;
  display: none;
}
.poll-reset.show { display: block; }
.poll-reset:hover { color: var(--gold); }

/* ══ WORKS CITED ══ */
.works-cited {
  background: #080705;
  padding: 5rem 7vw;
  border-top: 1px solid var(--rule);
}
.works-cited .inner { max-width: 760px; margin: 0 auto; }
.cite {
  font-size: 0.82rem;
  color: rgba(242,237,230,0.4);
  padding-left: 2em;
  text-indent: -2em;
  margin-bottom: 1rem;
  line-height: 1.65;
}
.cite em { font-style: italic; }

/* ══ FOOTER ══ */
footer {
  background: #050403;
  text-align: center;
  padding: 2.5rem;
  font-family: 'Martian Mono', monospace;
  font-size: 0.6rem;
  letter-spacing: 0.14em;
  color: rgba(242,237,230,0.18);
  border-top: 1px solid var(--rule);
}

@media (max-width: 640px) {
  .stat-grid { grid-template-columns: 1fr; }
  .arg-banner, .video-section, .poll-section, .works-cited { padding: 3rem 6vw; }
  .hero-content { padding: 3rem 6vw 4rem; }
}
</style>
</head>
<body>

<!-- ══════════════ HERO ══════════════ -->
<header class="hero" id="top">
  <div class="hero-img"></div>
  <div class="hero-content">
    <span class="hero-eyebrow">WRT 205 · Opinion Essay · May 2026</span>
    <h1>The State<br>of <em>AI:</em><br>A Force for<br>Good in the<br>Right Hands</h1>
    <p class="hero-sub">An opinion essay on artificial intelligence, what it has done for me as a student-athlete, and why I believe it will push education, business, and human capability to places we have never seen before.</p>
    <div class="hero-meta">GARRETT HOLMAN &nbsp;·&nbsp; WHITMAN SCHOOL OF MANAGEMENT &nbsp;·&nbsp; SYRACUSE UNIVERSITY</div>
  </div>
