<script>
// ── SCROLL REVEAL ──
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('visible');
    }
  });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// ── POLL LOGIC ──
const responses = [
  "That's the whole point of this essay. AI used with intention makes you more capable, not less.",
  "Fair. The key is being intentional. Use it to push your thinking, not bypass it.",
  "That concern is real and backed by research. The MIT study found exactly this. The answer is using it more deliberately.",
  "Completely valid. The risks are real. But the argument here is for better use, not abandonment."
];

// Simulated starting vote counts for realism
let votes = [42, 28, 18, 12];
let userVoted = false;
let userChoice = -1;

function vote(idx) {
  if (userVoted) return;
  userVoted = true;
  userChoice = idx;
  votes[idx]++;

  const total = votes.reduce((a,b) => a+b, 0);

  document.querySelectorAll('.poll-btn').forEach((btn, i) => {
    const pct = Math.round((votes[i]/total)*100);
    const bar = document.getElementById('bar' + i);
    const pctEl = document.getElementById('pct' + i);
    bar.style.width = pct + '%';
    pctEl.textContent = pct + '%';
    pctEl.classList.add('show');
    if (i === idx) btn.classList.add('selected');
    btn.disabled = true;
    btn.style.cursor = 'default';
  });

  const result = document.getElementById('pollResult');
  result.textContent = responses[idx];
  result.classList.add('show');

  document.getElementById('pollReset').classList.add('show');
}

function resetPoll() {
  userVoted = false;
  userChoice = -1;
  document.querySelectorAll('.poll-btn').forEach((btn, i) => {
    btn.disabled = false;
    btn.style.cursor = 'pointer';
    btn.classList.remove('selected');
    document.getElementById('bar' + i).style.width = '0';
    document.getElementById('pct' + i).classList.remove('show');
  });
  document.getElementById('pollResult').classList.remove('show');
  document.getElementById('pollReset').classList.remove('show');
}
</script>

</body>
</html>
